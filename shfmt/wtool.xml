<!--
  shfmt —— 上游 release 的 x86_64 静态二进制（② 类 `kind="muslbin"`，ADR-0045 §1.4）。

  来源：mvdan/sh   tag v3.14.1   license BSD-3-Clause
  当前版本、release 页、资产名与 sha256 见同目录的 readme.md（**先读它再升级**）。

  三件事别改坏：
    · `<muslbin>` 是**下载声明**（`download-release` 读它，并按 sha256 校验）。
      `tag` 必须钉死；`url` 必须指到**那个 tag** 的资产（不许用 latest）。
      `member` = 归档里要取的那个成员，`dest` = 解到 `__output/` 下的哪个相对路径。
    · `<export_bin src="__output/usr/bin/shfmt">` 的 src **必须在 __output/ 下**（D40）——
      它是"下载解出来的产物"，不是源码。落点由标签决定：$WTOOL_HOME/usr/bin/shfmt。
    · **本文件不写 PATH**：$WTOOL_HOME/usr/bin 由引擎统一放最前（ADR-0045 §1.2）。
-->
<wtool schema="1" kind="muslbin" priority="60">

  <zshrc  src="env.zsh"/>
  <bashrc src="env.bash"/>

  <muslbin url="https://github.com/mvdan/sh/releases/download/v3.14.1/shfmt_v3.14.1_linux_amd64"
           tag="v3.14.1" sha256="76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf"
           dest="usr/bin/shfmt" arch="x86_64"/>

  <export_bin src="__output/usr/bin/shfmt"/>
</wtool>

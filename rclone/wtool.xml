<!--
  rclone —— 上游 release 的 x86_64 静态二进制（② 类 `kind="muslbin"`，ADR-0045 §1.4）。

  来源：rclone/rclone   tag v1.75.2   license MIT
  当前版本、release 页、资产名与 sha256 见同目录的 readme.md（**先读它再升级**）。

  三件事别改坏：
    · `<muslbin>` 是**下载声明**（`download-release` 读它，并按 sha256 校验）。
      `tag` 必须钉死；`url` 必须指到**那个 tag** 的资产（不许用 latest）。
      `member` = 归档里要取的那个成员，`dest` = 解到 `__output/` 下的哪个相对路径。
    · `<export_bin src="__output/usr/bin/rclone">` 的 src **必须在 __output/ 下**（D40）——
      它是"下载解出来的产物"，不是源码。落点由标签决定：$WTOOL_HOME/usr/bin/rclone。
    · **本文件不写 PATH**：$WTOOL_HOME/usr/bin 由引擎统一放最前（ADR-0045 §1.2）。
-->
<wtool schema="1" kind="muslbin" priority="60">

  <zshrc  src="env.zsh"/>
  <bashrc src="env.bash"/>

  <muslbin url="https://github.com/rclone/rclone/releases/download/v1.75.2/rclone-v1.75.2-linux-amd64.zip"
           tag="v1.75.2" sha256="349ac8fba6ff65d6247043f1750cdcb518ec5d500ef91463a10d37c0ccdf3702"
           member="rclone-v1.75.2-linux-amd64/rclone" dest="usr/bin/rclone" arch="x86_64"/>

  <export_bin src="__output/usr/bin/rclone"/>
</wtool>
